{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "scan-sensitive": "node scripts/scan-sensitive.mjs",
        "test": "jest --passWithNoTests --maxWorkers=2",
        "test:slow": "JEST_INCLUDE_SLOW_TESTS=1 jest --passWithNoTests --testPathPatterns='\\.slow\\.test\\.[tj]sx?$'",
        "test:e2e": "playwright test",
        "test:e2e:tower-throwback": "playwright test tests/e2e/tower-throwback.visual.spec.ts tests/e2e/tower-throwback.drawcalls.spec.ts tests/e2e/tower-throwback.journey.spec.ts",
        "test:e2e:parking-pickup": "playwright test tests/e2e/parking-pickup.spec.ts",
        "test:e2e:parking-pickup-visual": "playwright test tests/e2e/parking-pickup.visual.spec.ts",
        "test:e2e:chicks-challenge": "playwright test tests/e2e/chicks-challenge.spec.ts",
        "test:e2e:marble-works": "playwright test tests/e2e/marble-works.spec.ts",
        "test:e2e:games-pwa": "playwright test tests/e2e/games-pwa.spec.ts --project=chromium-desktop",
        "test:e2e:mandarin": "playwright test tests/e2e/mandarin.journey.spec.ts tests/e2e/mandarin.visual.spec.ts tests/e2e/mandarin.live.spec.ts tests/e2e/mandarin.story.spec.ts --project=chromium-desktop --project=webkit-mobile-375",
        "type-check": "tsc --noEmit --jsx react-jsx",
        "type-check:e2e": "tsc --noEmit -p tsconfig.playwright.json",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix",
        "postinstall": "node scripts/spotlight-noindex.mjs"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.26.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@swc/core": "^1.16.18",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.29",
        "spotlight-noindex": "1.1.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "cannon-es": "^0.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "currency.js": "^2.0.4",
        "dayjs": "^1.11.23",
        "lucide-react": "^1.55.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0",
        "three": "^0.186.1",
        "ts-fsrs": "5.4.2",
        "zod": "^4.6.6"
    }
}
