{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "scan-sensitive": "node scripts/scan-sensitive.mjs",
        "test": "jest --passWithNoTests --maxWorkers=2",
        "test:slow": "JEST_INCLUDE_SLOW_TESTS=1 jest --passWithNoTests --testPathPatterns='\\.slow\\.test\\.[tj]sx?$'",
        "test:e2e": "playwright test",
        "test:e2e:tower-throwback": "playwright test tests/e2e/tower-throwback.visual.spec.ts tests/e2e/tower-throwback.drawcalls.spec.ts tests/e2e/tower-throwback.journey.spec.ts",
        "test:e2e:parking-pickup": "playwright test tests/e2e/parking-pickup.spec.ts",
        "test:e2e:parking-pickup-visual": "playwright test tests/e2e/parking-pickup.visual.spec.ts",
        "test:e2e:chicks-challenge": "playwright test tests/e2e/chicks-challenge.spec.ts",
        "test:e2e:games-pwa": "playwright test tests/e2e/games-pwa.spec.ts --project=chromium-desktop",
        "type-check": "tsc --noEmit --jsx react-jsx",
        "type-check:e2e": "tsc --noEmit -p tsconfig.playwright.json",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.18.6",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@swc/core": "^1.16.0",
        "@swc/jest": "^0.2.39",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/three": "^0.185.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.11.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "laravel-vite-plugin": "^3.1.3",
        "postcss": "^8.5.26",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.0",
        "vite-plugin-pwa": "^1.3.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "cannon-es": "^0.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "currency.js": "^2.0.4",
        "dayjs": "^1.11.21",
        "lucide-react": "^1.31.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0",
        "three": "^0.185.1",
        "zod": "^4.4.3"
    }
}
